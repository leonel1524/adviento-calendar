---
import Grid from '../components/Grid.astro';
import Layout from '../layouts/Layout.astro';
import { days } from '../data/days';
---

<Layout>
	<div class="calendar-container max-w-6xl mx-auto px-4">
		<div class="text-center mb-8">
			<h1 class="font-heading text-4xl md:text-5xl font-bold text-foreground mb-2">
				Calendario de Adviento
			</h1>
			<p class="font-body text-lg text-muted-foreground">
				Un regalo cada día hasta Navidad
			</p>
		</div>

		<script
			id="adviento-days"
			type="application/json"
			set:html={JSON.stringify(days)}
		/>

		<Grid days={days} />
	</div>
</Layout>
