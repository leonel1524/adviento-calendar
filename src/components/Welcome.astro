---
import Layout from '../layouts/Layout.astro';
import { path } from '../lib/paths';

// --- Generar elementos mágicos en el servidor ---
function randomRange(min: number, max: number): number {
	return Math.floor(Math.random() * (max - min + 1)) + min;
}

function randomFloat(min: number, max: number): number {
	return Math.random() * (max - min) + min;
}

function createSnowflakes(count: number) {
	const flakes: string[] = [];
	for (let i = 0; i < count; i++) {
		const size = randomFloat(2, 7);
		const left = randomFloat(0, 100);
		const top = randomFloat(0, 100);
		const opacity = randomFloat(0.2, 0.8);
		const duration = randomFloat(3, 7);
		const delay = randomFloat(0, 5);
		flakes.push(
			`<div class="snow-flake" style="width:${size}px;height:${size}px;left:${left}vw;top:${top}vh;opacity:${opacity};animation-duration:${duration}s;animation-delay:${delay}s"></div>`
		);
	}
	return flakes.join('');
}

function createStars(count: number) {
	const stars: string[] = [];
	for (let i = 0; i < count; i++) {
		const size = randomFloat(1.5, 4.5);
		const left = randomFloat(0, 100);
		const top = randomFloat(0, 50);
		const opacity = randomFloat(0.45, 0.95);
		const duration = randomFloat(2, 5);
		const delay = randomFloat(0, 5);
		stars.push(
			`<div class="star" style="width:${size}px;height:${size}px;left:${left}vw;top:${top}vh;opacity:${opacity};animation-duration:${duration}s;animation-delay:${delay}s"></div>`
		);
	}
	return stars.join('');
}

function createSparkles(count: number) {
	const sparkles: string[] = [];
	for (let i = 0; i < count; i++) {
		const size = randomFloat(7, 18);
		const left = randomFloat(0, 100);
		const top = randomFloat(0, 100);
		const duration = randomFloat(3, 7);
		const delay = randomFloat(0, 5);
		sparkles.push(
			`<div class="sparkle" style="width:${size}px;height:${size}px;left:${left}vw;top:${top}vh;animation-duration:${duration}s;animation-delay:${delay}s"></div>`
		);
	}
	return sparkles.join('');
}

const snowHTML = createSnowflakes(45);
const starsHTML = createStars(30);
const sparklesHTML = createSparkles(12);
---

<Layout>
	<!-- Capa mágica fija sobre todo el viewport (detrás del contenido) -->
	<div class="magic-layer fixed inset-0 z-0 pointer-events-none overflow-hidden">
		<!-- Trineo de Santa volando por el cielo -->
		<div class="sleigh-track">
			<svg
				class="sleigh-svg"
				viewBox="0 0 375 150"
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
			>
				<defs>
					<g id="reindeer">
						<!-- Patas traseras estiradas en vuelo -->
						<path d="M -12 8 C -22 12 -30 16 -38 18" stroke="#b45309" stroke-width="5" fill="none" stroke-linecap="round"/>
						<path d="M -4 11 C -14 17 -24 22 -32 26" stroke="#b45309" stroke-width="5" fill="none" stroke-linecap="round"/>
						<!-- Patas delanteras estiradas hacia atrás -->
						<path d="M 14 7 C 6 14 -2 19 -10 21" stroke="#b45309" stroke-width="5" fill="none" stroke-linecap="round"/>
						<path d="M 20 5 C 14 12 6 17 -2 22" stroke="#b45309" stroke-width="5" fill="none" stroke-linecap="round"/>
						<!-- Cola -->
						<ellipse cx="-26" cy="-6" rx="5" ry="4" fill="#d8a675" stroke="#0f172a" stroke-width="2"/>
						<!-- Cuerpo -->
						<ellipse cx="0" cy="0" rx="26" ry="13" fill="#c68b59" stroke="#0f172a" stroke-width="2.5"/>
						<!-- Cuello -->
						<path d="M 18 -4 L 32 -20 L 42 -12 L 26 4 Z" fill="#c68b59" stroke="#0f172a" stroke-width="2.5" stroke-linejoin="round"/>
						<!-- Collar con campana -->
						<path d="M 20 -8 L 33 -16" stroke="#dc2626" stroke-width="4.5" stroke-linecap="round"/>
						<circle cx="26" cy="-3" r="3" fill="#fbbf24" stroke="#0f172a" stroke-width="1.5"/>
						<!-- Cabeza -->
						<ellipse cx="40" cy="-24" rx="12" ry="8.5" transform="rotate(-20 40 -24)" fill="#c68b59" stroke="#0f172a" stroke-width="2.5"/>
						<!-- Hocico -->
						<ellipse cx="51" cy="-20" rx="5" ry="4" fill="#e8b78f" stroke="#0f172a" stroke-width="2"/>
						<!-- Nariz roja (Rudolph) -->
						<circle cx="55" cy="-21" r="2.8" fill="#dc2626" stroke="#0f172a" stroke-width="1.5"/>
						<!-- Oreja -->
						<path d="M 31 -30 C 27 -36 29 -41 34 -38 Z" fill="#c68b59" stroke="#0f172a" stroke-width="2"/>
						<!-- Cuernos -->
						<path d="M 37 -31 C 33 -39 37 -44 43 -43 M 41 -35 C 46 -41 51 -42 55 -44 M 43 -30 C 48 -36 53 -37 57 -38" stroke="#d97706" stroke-width="3" fill="none" stroke-linecap="round"/>
					</g>
				</defs>

				<!-- Riendas desde la mano de Santa hasta cada reno -->
				<path d="M 148 67 C 165 72 185 76 202 76" stroke="#fef3c7" stroke-width="2" fill="none" opacity="0.9"/>
				<path d="M 148 69 C 190 74 240 66 272 61" stroke="#fef3c7" stroke-width="2" fill="none" opacity="0.9"/>
				<path d="M 148 66 C 200 60 280 52 332 45" stroke="#fef3c7" stroke-width="2" fill="none" opacity="0.9"/>

				<!-- Renos -->
				<use href="#reindeer" transform="translate(180,78)"/>
				<use href="#reindeer" transform="translate(250,62)"/>
				<use href="#reindeer" transform="translate(310,46)"/>

				<!-- Corredor del trineo -->
				<path d="M 46 124 C 70 132 140 130 160 121 C 170 116 174 108 173 100" stroke="#fbbf24" stroke-width="6" fill="none" stroke-linecap="round"/>
				<!-- Soportes -->
				<path d="M 72 106 L 68 124" stroke="#fbbf24" stroke-width="4" stroke-linecap="round"/>
				<path d="M 132 106 L 138 122" stroke="#fbbf24" stroke-width="4" stroke-linecap="round"/>
				<!-- Base del trineo -->
				<path d="M 56 86 L 142 86 C 154 86 163 95 165 108 L 56 108 C 52 101 52 92 56 86 Z" fill="#dc2626" stroke="#0f172a" stroke-width="2.5" stroke-linejoin="round"/>
				<!-- Franja dorada -->
				<path d="M 64 93 L 136 93" stroke="#fbbf24" stroke-width="5" stroke-linecap="round"/>

				<!-- Santa -->
				<path d="M 108 70 C 120 66 134 66 143 68" stroke="#dc2626" stroke-width="9" fill="none" stroke-linecap="round"/>
				<circle cx="147" cy="69" r="6.5" fill="#ffffff" stroke="#0f172a" stroke-width="2"/>
				<path d="M 74 88 C 72 66 82 56 94 56 C 106 56 116 66 114 88 Z" fill="#dc2626" stroke="#0f172a" stroke-width="2.5"/>
				<rect x="74" y="76" width="40" height="9" fill="#0f172a"/>
				<rect x="89" y="76" width="10" height="9" fill="#fbbf24"/>
				<circle cx="97" cy="44" r="13" fill="#fcd3b5" stroke="#0f172a" stroke-width="2.5"/>
				<path d="M 85 43 C 83 57 93 67 104 61 C 112 56 114 45 111 37 C 103 46 92 47 85 43 Z" fill="#ffffff" stroke="#0f172a" stroke-width="2"/>
				<circle cx="110" cy="45" r="3.5" fill="#fca5a5" stroke="#0f172a" stroke-width="1.5"/>
				<circle cx="105" cy="40" r="1.8" fill="#0f172a"/>
				<path d="M 84 35 C 86 21 101 15 111 23 C 116 27 118 32 118 36 Z" fill="#dc2626" stroke="#0f172a" stroke-width="2.5"/>
				<path d="M 82 36 L 119 36" stroke="#ffffff" stroke-width="8" stroke-linecap="round"/>
				<circle cx="120" cy="20" r="6" fill="#ffffff" stroke="#0f172a" stroke-width="2"/>
			</svg>
		</div>

		<div class="snow-container fixed inset-0" set:html={snowHTML}></div>
		<div class="stars-container fixed inset-0" set:html={starsHTML}></div>
		<div class="sparkles-container fixed inset-0" set:html={sparklesHTML}></div>
	</div>

	<!-- Contenido principal -->
	<div class="relative z-10 flex flex-col items-center justify-center min-h-screen w-full gap-8 px-6 text-foreground">
		<section class="max-w-2xl text-center space-y-4">
			<h1 class="font-heading text-5xl md:text-7xl font-bold text-foreground tracking-tight drop-shadow-md">
				Calendario de Adviento
			</h1>
			<p class="font-body text-lg text-muted-foreground drop-shadow-sm">
				24 días, 24 sorpresas. Abre una cajita cada día y descubre qué hay dentro.
			</p>
		</section>
		<a href={path('calendar')} class="btn-primary">
			Empezar
			<span aria-hidden="true" class="ml-2">➡️</span>
		</a>
	</div>
</Layout>
<style is:global>
	.magic-layer {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		z-index: 0;
		pointer-events: none;
	}

	.snow-container,
	.stars-container,
	.sparkles-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
	}

	/* --- Trineo: vuelo lateral + vaivén --- */
	.sleigh-track {
		position: absolute;
		top: 9%;
		left: 0;
		width: min(340px, 60vw);
		animation: sleigh-fly 16s linear infinite;
		will-change: transform;
	}

	.sleigh-svg {
		display: block;
		width: 100%;
		height: auto;
		animation: sleigh-bob 2.2s ease-in-out infinite;
		filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
	}

	@keyframes sleigh-fly {
		0% {
			transform: translateX(-420px);
		}
		100% {
			transform: translateX(calc(100vw + 420px));
		}
	}

	@keyframes sleigh-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-2deg);
		}
		50% {
			transform: translateY(-16px) rotate(2deg);
		}
	}

	/* --- Nieve --- */
	.snow-flake {
		position: absolute;
		background: #ffffff;
		border-radius: 50%;
		pointer-events: none;
		animation: snow-fall linear infinite;
		opacity: 0.8;
	}

	@keyframes snow-fall {
		0% {
			transform: translateY(-10px) translateX(0) rotate(0deg);
			opacity: 0.8;
		}
		100% {
			transform: translateY(110vh) translateX(20px) rotate(360deg);
			opacity: 0.3;
		}
	}

	/* --- Estrellas --- */
	.star {
		position: absolute;
		background: #ffffff;
		border-radius: 50%;
		pointer-events: none;
		animation: star-twinkle ease-in-out infinite;
	}

	@keyframes star-twinkle {
		0%,
		100% {
			opacity: 0.3;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.4);
		}
	}

	/* --- Brillos mágicos --- */
	.sparkle {
		position: absolute;
		background: radial-gradient(circle, #fff 0%, transparent 70%);
		border-radius: 50%;
		pointer-events: none;
		animation: sparkle-float ease-in-out infinite;
		opacity: 0;
	}

	@keyframes sparkle-float {
		0% {
			transform: translateY(0) scale(0.5);
			opacity: 0;
		}
		20% {
			opacity: 1;
		}
		80% {
			opacity: 1;
		}
		100% {
			transform: translateY(-40px) scale(0);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.snow-flake,
		.star,
		.sparkle {
			animation: none;
			opacity: 0.2;
		}
		.sleigh-track {
			animation: none;
			transform: translateX(35vw);
		}
		.sleigh-svg {
			animation: none;
		}
	}
</style>
