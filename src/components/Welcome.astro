---
import Layout from '../layouts/Layout.astro';
import sleighImg from '../assets/sleigh.png';

// --- Generar elementos mágicos en el servidor ---
function randomRange(min: number, max: number): number {
	return Math.floor(Math.random() * (max - min + 1)) + min;
}

function randomFloat(min: number, max: number): number {
	return Math.random() * (max - min) + min;
}

function createSnowflakes(count: number) {
	const flakes: string[] = [];
	for (let i = 0; i < count; i++) {
		const size = randomFloat(2, 7);
		const left = randomFloat(0, 100);
		const top = randomFloat(0, 100);
		const opacity = randomFloat(0.2, 0.8);
		const duration = randomFloat(3, 7);
		const delay = randomFloat(0, 5);
		flakes.push(
			`<div class="snow-flake" style="width:${size}px;height:${size}px;left:${left}vw;top:${top}vh;opacity:${opacity};animation-duration:${duration}s;animation-delay:${delay}s"></div>`
		);
	}
	return flakes.join('');
}

function createStars(count: number) {
	const stars: string[] = [];
	for (let i = 0; i < count; i++) {
		const size = randomFloat(1.5, 4.5);
		const left = randomFloat(0, 100);
		const top = randomFloat(0, 50);
		const opacity = randomFloat(0.45, 0.95);
		const duration = randomFloat(2, 5);
		const delay = randomFloat(0, 5);
		stars.push(
			`<div class="star" style="width:${size}px;height:${size}px;left:${left}vw;top:${top}vh;opacity:${opacity};animation-duration:${duration}s;animation-delay:${delay}s"></div>`
		);
	}
	return stars.join('');
}

function createSparkles(count: number) {
	const sparkles: string[] = [];
	for (let i = 0; i < count; i++) {
		const size = randomFloat(7, 18);
		const left = randomFloat(0, 100);
		const top = randomFloat(0, 100);
		const duration = randomFloat(3, 7);
		const delay = randomFloat(0, 5);
		sparkles.push(
			`<div class="sparkle" style="width:${size}px;height:${size}px;left:${left}vw;top:${top}vh;animation-duration:${duration}s;animation-delay:${delay}s"></div>`
		);
	}
	return sparkles.join('');
}

const snowHTML = createSnowflakes(45);
const starsHTML = createStars(30);
const sparklesHTML = createSparkles(12);
---

<Layout>
	<!-- Capa mágica fija sobre todo el viewport (detrás del contenido) -->
	<div class="magic-layer fixed inset-0 z-0 pointer-events-none overflow-hidden">
		<!-- Trineo de Santa volando por el cielo -->
		<div class="sleigh-track">
			<img
				class="sleigh-img"
				src={sleighImg.src}
				alt=""
				aria-hidden="true"
				width="1116"
				height="388"
				decoding="async"
			/>
		</div>

		<div class="snow-container fixed inset-0" set:html={snowHTML}></div>
		<div class="stars-container fixed inset-0" set:html={starsHTML}></div>
		<div class="sparkles-container fixed inset-0" set:html={sparklesHTML}></div>
	</div>

	<!-- Contenido principal -->
	<div class="relative z-10 flex flex-col items-center justify-center min-h-screen w-full gap-8 px-6 text-foreground">
		<section class="max-w-2xl text-center space-y-4">
			<h1 class="font-heading text-5xl md:text-7xl font-bold text-foreground tracking-tight drop-shadow-md">
				Calendario de Adviento
			</h1>
			<p class="font-body text-lg text-muted-foreground drop-shadow-sm">
				24 días, 24 sorpresas. Abre una cajita cada día y descubre qué hay dentro.
			</p>
		</section>
		<a href="/calendar" class="btn-primary">
			Empezar
			<span aria-hidden="true" class="ml-2">➡️</span>
		</a>
	</div>
</Layout>

/* is:global: los elementos inyectados con set:html no llevan el atributo
   data-astro-cid de Astro, así que necesitan reglas globales para aplicar */
<style is:global>
	.magic-layer {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		z-index: 0;
		pointer-events: none;
	}

	.snow-container,
	.stars-container,
	.sparkles-container {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
	}

	/* --- Trineo: vuelo lateral + vaivén --- */
	.sleigh-track {
		position: absolute;
		top: 9%;
		left: 0;
		width: min(340px, 60vw);
		animation: sleigh-fly 16s linear infinite;
		will-change: transform;
	}

	.sleigh-img {
		display: block;
		width: 100%;
		height: auto;
		animation: sleigh-bob 2.2s ease-in-out infinite;
		filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.35));
	}

	@keyframes sleigh-fly {
		0% {
			transform: translateX(-420px);
		}
		100% {
			transform: translateX(calc(100vw + 420px));
		}
	}

	@keyframes sleigh-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-2deg);
		}
		50% {
			transform: translateY(-16px) rotate(2deg);
		}
	}

	/* --- Nieve --- */
	.snow-flake {
		position: absolute;
		background: #ffffff;
		border-radius: 50%;
		pointer-events: none;
		animation: snow-fall linear infinite;
		opacity: 0.8;
	}

	@keyframes snow-fall {
		0% {
			transform: translateY(-10px) translateX(0) rotate(0deg);
			opacity: 0.8;
		}
		100% {
			transform: translateY(110vh) translateX(20px) rotate(360deg);
			opacity: 0.3;
		}
	}

	/* --- Estrellas --- */
	.star {
		position: absolute;
		background: #ffffff;
		border-radius: 50%;
		pointer-events: none;
		animation: star-twinkle ease-in-out infinite;
	}

	@keyframes star-twinkle {
		0%,
		100% {
			opacity: 0.3;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.4);
		}
	}

	/* --- Brillos mágicos --- */
	.sparkle {
		position: absolute;
		background: radial-gradient(circle, #fff 0%, transparent 70%);
		border-radius: 50%;
		pointer-events: none;
		animation: sparkle-float ease-in-out infinite;
		opacity: 0;
	}

	@keyframes sparkle-float {
		0% {
			transform: translateY(0) scale(0.5);
			opacity: 0;
		}
		20% {
			opacity: 1;
		}
		80% {
			opacity: 1;
		}
		100% {
			transform: translateY(-40px) scale(0);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.snow-flake,
		.star,
		.sparkle {
			animation: none;
			opacity: 0.2;
		}
		.sleigh-track {
			animation: none;
			transform: translateX(35vw);
		}
		.sleigh-img {
			animation: none;
		}
	}
</style>
