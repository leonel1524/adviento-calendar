<div class="container">
  <div class="sideLeft">
    {Array.from({ length: 12 }).map((_, i) => (
      <div class="small-box" id={`left-${i}`}>{i+1}</div>
    ))}
  </div>
  <div class="center-box">
    Sigue a Papá Noel
  </div>
  <div class="sideRight">
    {Array.from({ length: 12 }).map((_, i) => (
      <div class="small-box" id={`right-${i}`}>{i+13}</div>
    ))}
  </div>
</div>
<style>
.container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  gap: 2rem;
}
.side {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.sideLeft, .sideRight {
  display: flex;
  flex-direction: row;
  gap: 0.5rem;
  flex-wrap: wrap;
  width: 40%;
  justify-content: center;
}
.small-box {
  width: 200px;
  height: 200px;
  background: #eee;
  border: 2px solid #ccc;
  border-radius: 8px;
  font-size: 4rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Lobster';
}
.center-box {
  width: 400px;
  height: 400px;
  background: #b3e5fc;
  border: 3px solid #0288d1;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 5rem;
  font-weight: bold;
  color: #0288d1;
  text-align: center;
  font-family: 'Lobster';
}
</style>